# DevOpsLens AI - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB maximum file upload size
ALLOWED_EXTENSIONS=.log,.txt

# Database Configuration
DATABASE_URL=sqlite:///./devopslens.db

# AI Provider Configuration
# Set AI_PROVIDER to 'offline' (default, requires no key) or 'gemini' / 'openai'
AI_PROVIDER=offline

# Optional External API Keys (Leave empty to use built-in heuristic diagnosis)
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=10.0
